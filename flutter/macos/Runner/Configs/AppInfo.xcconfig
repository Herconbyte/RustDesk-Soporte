// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// Con espacio a proposito: debe coincidir EXACTO con APP_NAME / get_app_name()
// ("Soporte Herconbyte"), porque correct_app_name() reemplaza "RustDesk" por ese
// valor en los paths de los plists del servicio (daemon/agent). Si no coinciden,
// el modo servicio apunta a un ejecutable inexistente. Ver src/platform/macos.rs.
PRODUCT_NAME = Soporte Herconbyte

// The application's bundle identifier.
// OJO: el que manda de verdad es el del project.pbxproj (lo pisa); este se deja igual
// para que no queden dos valores distintos dando vueltas.
// macOS ata los permisos (Accesibilidad, Grabacion de pantalla) a este identificador:
// si se cambia, TODA instalacion existente los pierde y hay que volver a tildarlos.
PRODUCT_BUNDLE_IDENTIFIER = com.herconbyte.soporte

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Herconbyte. All rights reserved.
